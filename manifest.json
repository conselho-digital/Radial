{
  "manifest_version": 3,
  "name": "Radial",
  "version": "1.5.0",
  "description": "Menu radial contextual no cursor: ações por site (Sheets, Docs, Teams) e bookmarklets personalizados.",
  "permissions": ["storage", "unlimitedStorage", "scripting", "tabs", "userScripts"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["sites.js", "radial-css.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "open-radial": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Abrir o menu radial no cursor"
    }
  },
  "action": {
    "default_title": "Opções do radial neste site",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
