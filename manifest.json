{
  "manifest_version": 3,
  "name": "Radial",
  "version": "1.46.1",
  "description": "Contextual radial menu at the cursor: per-site actions, recorded shortcuts and your own bookmarklets.",
  "permissions": ["storage", "unlimitedStorage", "scripting", "tabs", "debugger"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["sites.js", "store.js", "i18n-labels.js", "i18n-ui.js", "i18n.js", "radial-css.js", "content.js", "templates.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://configuration.sicharge.technology/*"],
      "js": ["sicharge.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "open-radial": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Open the radial menu at the cursor"
    }
  },
  "action": {
    "default_title": "Radial options for this site",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
